# ==============================================================================
# Janith Income - JJ Online Business Environment Configuration
# ==============================================================================
# IMPORTANT SECURITY NOTICE:
# 1. NEVER commit your actual .env file to GitHub or any public repository.
# 2. DO NOT put your Netlify Personal Access Token (nfp_...) in this file or any client code.
#    The Netlify token is strictly for deployment scripts or the Netlify CLI on your computer.
# 3. For Supabase: Only use the public Anon Key here (which is protected by Row Level Security).
#    NEVER use your Supabase service_role secret key in the front-end!
# ==============================================================================

# Supabase (Optional - the app works fully offline/locally with LocalStorage if these are empty)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Default Currency (LKR, USD, EUR, GBP, INR)
VITE_DEFAULT_CURRENCY=LKR

# Default WhatsApp Business Contact (Optional - e.g. 94771234567 without +)
VITE_WHATSAPP_PHONE=
